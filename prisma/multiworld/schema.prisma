// src/db/types.ts is generated from prisma/postgres/schema.prisma only - see the
// note at the top of that file. Keep the models here in step with it (minus the
// postgres-only hiscore sort index) so every backend has the same columns.

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model ipban {
    ip String @id
}

model account {
    id Int @id @default(autoincrement())

    username String @unique
    password String

    email            String
    email_normalized String

    registration_ip    String?
    registration_group String?
    registration_date  DateTime @default(now())
    signup_agent_hash  String?

    muted_until    DateTime?
    banned_until   DateTime?
    playable_after DateTime?

    staffmodlevel Int     @default(0)
    members       Boolean @default(false)

    @@index([email_normalized])
    @@index([registration_ip])
    @@index([registration_group])
}

model signup_attempt {
    id         Int      @id @default(autoincrement())
    ip         String
    ip_group   String
    created_at DateTime @default(now())

    @@index([ip, created_at])
    @@index([ip_group, created_at])
}

model login_attempt {
    id         Int      @id @default(autoincrement())
    username   String
    ip         String
    created_at DateTime @default(now())

    @@index([username, created_at])
    @@index([ip, created_at])
}

model account_login {
    account_id Int
    profile    String

    logged_in  Int       @default(0)
    login_time DateTime?

    logged_out  Int       @default(0)
    logout_time DateTime?

    @@id([profile, account_id])
}

model hiscore {
    account_id Int
    profile    String @default("main")
    type       Int

    level Int
    value Int
    date  DateTime @default(now()) @updatedAt

    @@id([profile, type, account_id])
}

model hiscore_large {
    account_id Int
    profile    String @default("main")
    type       Int

    level Int
    value BigInt
    date  DateTime @default(now()) @updatedAt

    @@id([profile, type, account_id])
}

model friendlist {
    account_id        Int
    friend_account_id Int
    profile           String @default("main")

    created DateTime @default(now())

    @@id([profile, account_id, friend_account_id])
}

model ignorelist {
    account_id Int
    value      String
    profile    String @default("main")

    created DateTime @default(now())

    @@id([profile, account_id, value])
}

model session {
    uuid String @id

    account_id Int
    profile    String
    world      Int
    timestamp  DateTime

    uid Int
    ip  String?

    @@index([profile, account_id, timestamp(sort: Desc)])
}

model session_log {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord      Int
    event      String
    event_type Int    @default(-1)
}

model session_wealth {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord      Int
    event_type Int @default(-1)

    account_items String @db.MediumText
    account_value Int

    recipient_session String?
    recipient_items   String? @db.MediumText
    recipient_value   Int?
}

model public_chat {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord   Int
    message String
}

model private_chat {
    id Int @id @default(autoincrement())

    account_id Int
    profile    String

    timestamp     DateTime
    coord         Int
    to_account_id Int
    message       String
}

model report {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    coord    Int
    offender String
    reason   Int

    // who pressed Report Abuse, and on which world. Null on the rows written
    // before the login server took the packet over from the (disabled) logger.
    reporter_account_id Int?
    world               Int?

    @@index([timestamp(sort: Desc)])
}

model input_report {
    id Int @id @default(autoincrement())

    session_uuid String
    timestamp    DateTime

    data Bytes
}

// ---------------------------------------------------------------------------
// the message centre
// ---------------------------------------------------------------------------
//
// One unread rule everywhere, and it is a cross-repo contract pinned in
// test/fixtures/message-centre-contract.json:
//
//     count(*) from account_message where account_id = $1 and read_at is null
//
// which is both the number the login server puts on the client's welcome
// screen and the number the website's Message Centre shows. No foreign keys,
// like every other table here; the SQL API in
// prisma/postgres/migrations/3_message_centre owns the rules the website is
// allowed to rely on.

model account_message {
    id Int @id @default(autoincrement())

    // ticket_id is null for a standalone notice and set when a staff reply
    // lands on a ticket; kind is welcome | notice | ban | mute | reply;
    // created_by_account_id is null when the system wrote the row rather than
    // a person.
    account_id            Int
    ticket_id             Int?
    kind                  String
    subject               String
    body                  String @db.Text
    created_by_account_id Int?

    created_at DateTime  @default(now())
    read_at    DateTime?

    @@index([account_id, read_at])
    @@index([account_id, created_at(sort: Desc)])
}

model ticket {
    id Int @id @default(autoincrement())

    // kind is bug | appeal | other, status is open | closed
    account_id Int
    kind       String
    subject    String
    status     String @default("open")

    created_at DateTime @default(now())
    updated_at DateTime @default(now())

    @@index([account_id, updated_at(sort: Desc)])
    @@index([status, updated_at(sort: Desc)])
}

model ticket_message {
    id Int @id @default(autoincrement())

    ticket_id         Int
    author_account_id Int
    from_staff        Boolean @default(false)
    body              String @db.Text

    created_at DateTime @default(now())

    @@index([ticket_id, created_at])
    @@index([author_account_id, created_at])
}

model staff_action {
    id Int @id @default(autoincrement())

    // action names the staff function that ran, target what it acted on
    actor_account_id Int
    action           String
    target           String

    created_at DateTime @default(now())

    @@index([actor_account_id, action, created_at])
}
